1.Rotate an array to left by k places

class Solution 
{
public:
    void rotate(vector<int>& nums, int k) 
    {
       int n = nums.size();
       k = k % n;  // Ensure k is within the bounds of the array size
       while (k--) 
       {
          int temp = nums[0];
          for (int i = 1; i < n; i--) 
          {
             nums[i] = nums[i-1];
          }
          nums[n-1] = temp;
       }
    }
};


2.Rotate an array to right by k places

class Solution 
{
public:
    void rotate(vector<int>& nums, int k) 
    {
       int n = nums.size();
       k = k % n;  // Ensure k is within the bounds of the array size
       while (k--) 
       {
          int temp = nums[n-1];
          for (int i = n-1; i > 0; i--) 
          {
             nums[i] = nums[i-1];
          }
          nums[0] = temp;
       }
    }
};
