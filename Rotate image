#include<bits/stdc++.h>

using namespace std;
vector < vector < int >> rotate(vector < vector < int >> & matrix) {
    int n = matrix.size();
    vector < vector < int >> rotated(n, vector < int > (n, 0));
    for (int i = 0; i < n; i++) {
    for (int j = 0; j < n; j++) {
        rotated[j][n - i - 1] = matrix[i][j];
    }
    }
    return rotated;
}

}

2.Optimal approach  //Transpose the matrix then reverse all rows to get final matrix
class Solution 
{
public:
    void rotate(vector<vector<int>>& matrix) 
    {
        int n=matrix.size();
        for(int i=0;i<n-1;i++)
        {
            for(int j=i+1;j<n;j++)
            {
                swap(matrix[i][j] , matrix[j][i]);
            }
        }
        for(int i=0;i<n;i++)
        {
            reverse(matrix[i].begin() , matrix[i].end());
        }
    }
};

or

class Solution 
{
public:
    void rotate(vector<vector<int>>& matrix) 
    {
        int n=matrix.size();
        for(int i=0;i<n-1;i++)
        {
            for(int j=i+1;j<n;j++)
            {
                swap(matrix[i][j] , matrix[j][i]);  //transpose the matrix
            }
        }
        for(int i=0;i<n;i++)
        {
           int p1=0 , p2=n-1;
           while(p1<p2)
           {
              swap(matrix[i][p1] , matrix[i][p2]);  //logic of reversing the elements of each row 
              p1++;
              p2--;
           }
        }
    }
};
