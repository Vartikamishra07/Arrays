1.Brute approach

class Solution 
{
    // Function to find the leaders in the array.
  public:
    vector<int> leaders(int n, int arr[]) 
    {
        vector<int>res;
        for(int i=0;i<n;i++)
        {
            int flag=0;
            int num=arr[i];
            for(int j=i+1;j<n;j++)
            {
                if(num<arr[j])
                {
                    flag=1;
                    break;
                }
            }
            if(!flag)
            {
                res.push_back(num);
            }
        }
        return res;
    }
};


2.Optimal appraoch

class Solution 
{
    // Function to find the leaders in the array.
  public:
    vector<int> leaders(int n, int arr[]) 
    {
       vector<int>v;
       int maxi=arr[n-1];
       for(int i=n-1;i>=0;i--)
       {
           if(arr[i]>=maxi)
           {
               maxi=arr[i];
               v.push_back(arr[i]);
           }
       }
       reverse(v.begin() , v.end());
       return v;
    }
};
