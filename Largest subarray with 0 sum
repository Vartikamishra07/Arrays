1.Brute appraoch

class Solution 
{
  public:
    int maxLen(vector<int>& arr, int n) 
    {
        int count=0;
        for(int i=0;i<n;i++)
        {
            int sum=0;
            for(int j=i;j<n;j++)
            {
                sum+=arr[j];
                if(sum==0)
                {
                    count=max(count , j-i+1);
                }
            }
        }
        return count;
    }
};


2. Optimal appraoch

class Solution {
public:
    int maxLen(vector<int>& arr, int n) {
        unordered_map<int, int> sumMap; // Hash map to store (sum, index)
        int sum = 0;                    // Cumulative sum
        int maxLength = 0;              // Variable to store the maximum length

        for (int i = 0; i < n; i++) {
            sum += arr[i]; // Add current element to cumulative sum

            // If sum is 0, the subarray from index 0 to i has sum 0
            if (sum == 0) {
                maxLength = i + 1;
            }

            // If this sum has been seen before, update the max length
            if (sumMap.find(sum) != sumMap.end()) {
                maxLength = max(maxLength, i - sumMap[sum]);
            } else {
                // Store sum with its index if it's the first time we're seeing it
                sumMap[sum] = i;
            }
        }

        return maxLength; // Return the maximum length of the subarray with sum 0
    }
};
