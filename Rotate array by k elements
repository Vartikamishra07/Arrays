1.Rotate an array to left by k places

class Solution 
{
public:
    void rotate(vector<int>& nums, int k) 
    {
       int n = nums.size();
       k = k % n;  // Ensure k is within the bounds of the array size
       while (k--) 
       {
          int temp = nums[0];
          for (int i = 1; i < n; i--) 
          {
             nums[i] = nums[i-1];
          }
          nums[n-1] = temp;
       }
    }
};


2.Rotate an array to right by k places


#method-1
class Solution 
{
public:
    void rotate(vector<int>& nums, int k) 
    {
       int n = nums.size();
       k = k % n;  // Ensure k is within the bounds of the array size
       while (k--) 
       {
          int temp = nums[n-1];
          for (int i = n-1; i > 0; i--) 
          {
             nums[i] = nums[i-1];
          }
          nums[0] = temp;
       }
    }
};

#method-2
class Solution 
{
public:
    void rotate(vector<int>& nums, int k) 
    {
        int n = nums.size();
        if (n == 0)
            return;
        
        k = k % n;  // Ensure k is within the bounds of the array size
        
        // Copy the last k elements into a temporary array
        int temp[k];
        for (int i = 0; i < k; i++) 
        {
            temp[i] = nums[n - k + i];
        }
        
        // Shift the rest of the elements to the right
        for (int i = n - 1; i >= k; i--) 
        {
            nums[i] = nums[i - k];
        }
        
        // Copy the elements from temp back into the array
        for (int i = 0; i < k; i++) 
        {
            nums[i] = temp[i];
        }
    }
};
